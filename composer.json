{
  "name": "crowveil/xboard-friend-invite",
  "description": "Private friend invitations and Telegram administration for XBoard",
  "require": {
    "guzzlehttp/guzzle": "^7.8",
    "laravel/framework": "^12.0",
    "php": "^8.2"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Plugin\\FriendInvite\\": "FriendInvite/"
    }
  },
  "config": {
    "allow-plugins": {},
    "sort-packages": true
  },
  "license": "MIT",
  "authors": [
    {
      "name": "crowveil"
    }
  ],
  "scripts": {
    "test": "phpunit",
    "format": "pint",
    "format:check": "pint --test"
  }
}
